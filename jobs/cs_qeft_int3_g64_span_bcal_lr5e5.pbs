#!/bin/bash
#PBS -N cs_qeft_int3_g64_bcal_lr5e5
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=24:00:00
#PBS -j oe

# lr 5e-5 arm (10x the paper): see the config header. Training stays on 2 GPUs (--num_gpus 2,
# same effective batch); the node has 4 so the eval runs TP=4, which is the configuration that
# evaluates this export cleanly (TP=2 + bf16 crashes vLLM's sampler at 22313-22316/22419 on every
# attempt; jobs 15825005/15831682/15825006 vs the clean TP=4 run 15838948).
# QEFT INT3 g64, k=128 weak columns, Commonsense-170k, 1 epoch,
# loss_span=instruction+response, BALANCED calibration -- the bcal cell, next to QA-LoRA, QWHA
# and SALT-Q's bcal rows.
#
# HOW TO READ IT. Only against the other bcal rows. And NOT as a pure INT3 row: QEFT deploys as
# INT3 codes PLUS k=128 fp16 columns per linear, so it belongs next to the fp16-salient PTQ rows
# as "3 + fp16" (the export meta carries the exact fp16 share and effective bit width). The
# --with_base scores the bare mixed-precision base -- INT3 + k=128 fp16 columns, no tuning -- through
# the same seam. That is this row's own floor, and it is NOT the fp16-salient PTQ sweep's k=128
# point: the sweep quantizes an already QLoRA-fine-tuned merged checkpoint, while QEFT (like
# QA-LoRA, SALT-Q and LoTA-QAF) starts from the pre-trained model, so its floor is a model that has
# never seen the instruction format -- expect something like LoTA-QAF's own floor (8.72), not 66-77.
#
# 2 GPUs, not 4, at the SAME effective batch 80 (per_device 5 x accum 8 x 2): the g3 queue had no
# schedulable 4-GPU node (the four wide enough were offline), and 2 GPUs start now. The step count
# T is unchanged, so every learning rate transports unchanged and the cell is the same one; only
# wall clock doubles (~10 h instead of ~5 h). Eval runs vLLM at tensor-parallel 2.
#
# Depends on jobs/qeft_prep_int3_g64_bcal.pbs having produced the base.
# Train + export + eval + collection all land in the one log below.
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export HF_HUB_DISABLE_XET=1
mkdir -p logs/commonsense_170k
bash runs/qeft/run_qeft_commonsense.sh \
    --config     baseline/QEFT/sqat/configs/qeft_cs170k_int3_g64_ep1_span_bcal_lr5e5.yaml \
    --bits       3 \
    --group_size 64 \
    --skip_base \
    --with_base \
    --num_gpus   2 \
    --eval_gpus  0,1,2,3 \
    --note       "lr 5e-5 (10x paper): 5e-6 under-trained (66.73, weak columns moved max 0.004); eval at TP=4 — TP=2 bf16 crashes vLLM sampler deterministically" \
    > logs/commonsense_170k/qeft_cs170k_int3_g64_ep1_span_bcal_lr5e5.log 2>&1
rc=$?
echo "rc=$rc"; echo "End time: $(date)"
# The job's exit status IS the dependency signal: a downstream `-W depend=afterok:` job is
# released on it. Ending on `echo` would hand PBS the echo's 0 no matter how the run went.
exit $rc
