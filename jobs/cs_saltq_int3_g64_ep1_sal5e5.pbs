#!/bin/bash
#PBS -N cs_saltq_sal5e5
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# SALT-Q Commonsense INT3 g64, 1 epoch, salient_lr = 5.0e-5. Bracketing point on the curve.
#
#   salient_lr   |dW_S| p50   MEAN(8)   MEAN(7, no openbookqa)
#   0 (z-only)      --         80.44         80.53
#   5.0e-5        0.040        <- sal5e5
#   1.0e-4        0.079        81.46         80.98      best so far
#   2.0e-4        0.158        <- sal2e4
#   3.46e-4       0.273        79.04
#
# Non-monotone with an interior optimum near 1e-4. If both bracketing points land under 81.46 the
# peak is located and the cell can be fixed for the 3-epoch runs; if one is higher, the sweep
# continues that way.
#
# PREDICTED |dW_S| = 0.040 GRID STEPS. c = |dW_S|/lr measured 9.6 / 9.7 / 9.7 across three runs
# here, so displacement follows from lr: the 1e-4 point was predicted at 0.079 and landed at
# 0.079 exactly. A miss means something other than lr moved.
#
# DO NOT act on measure_saltq_displacement.py's ~0.5-step target. It is MetaMath-derived and has
# been wrong on this dataset twice -- the best score sits six times below it, and the in-band
# 0.273 was the worst of the three.
#
# READ MEAN(7) ALONGSIDE MEAN(8): openbookqa has 500 test examples and a stderr near 2.4, and it
# carried nearly the whole +0.38 by which the 1e-4 point appears to lead QA-LoRA's 81.08.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }

set -x
python scripts/test_saltq_base_provenance.py || exit 1
set +x

mkdir -p logs/commonsense_170k
bash runs/saltq/run_saltq_commonsense.sh \
    --config            configs/saltq_cs170k_int3_g64_ep1_sal5e5.yaml \
    --bits              3 \
    --output_root       outputs/saltq_cs170k_int3_g64_ep1_sal5e5 \
    --train_layernorms  false \
    --permuted_base_dir outputs/saltq_cs170k_int3_g64_ep1/permuted_fp16_base \
    --saltq_base_dir    outputs/saltq_cs170k_int3_g64_ep1/saltq_base_3bit_g64 \
    --note              "salient_lr 5.0e-5 (bracketing point; 1e-4 -> 81.46, z-only -> 80.44, 3.46e-4 -> 79.04)" \
    > logs/commonsense_170k/saltq_cs170k_int3_g64_ep1_sal5e5.log 2>&1
echo "rc=$?"
echo "End time: $(date)"
