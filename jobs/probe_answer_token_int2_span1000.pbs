#!/bin/bash
#PBS -N probe_span1000
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=1
#PBS -l walltime=2:00:00
#PBS -j oe
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh; conda activate saltq
# Answer-token probe on the loss_span=instruction+response anchor, checkpoint 1000 (see the
# step-500 job for the read rule). Together with 500/1000/1500/final this is the answer-token
# CURVE under dense supervision, the number the plateau story is actually about.
mkdir -p logs/probe results/probe
python scripts/probe_answer_token.py \
    --config configs/saltq_cs170k_int2_g32_ep1_span.yaml \
    --saltq_base_dir outputs/saltq_cs170k_int2_g32_ep1/saltq_base_2bit_g32 \
    --checkpoints outputs/saltq_cs170k_int2_g32_ep1_span-2bit-saltq-ckpts/checkpoint-1000 \
    --per_task 64 --batch 8 \
    --out results/probe/saltq_cs170k_int2_g32_ep1_span_ckpt1000.json \
    > logs/probe/saltq_cs170k_int2_g32_ep1_span_ckpt1000.log 2>&1
echo "rc=$?"; echo "End time: $(date)"
