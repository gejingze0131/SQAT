#!/bin/bash
#PBS -N alpaca_ep6_b
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=24:00:00
#PBS -j oe
# =============================================================================
# ALPACA column, INT2 g32 cell REDONE AT 6 EPOCHS — part B: QA-LoRA and the QLoRA bounds.
#
# The bounds move with the cell: a 6-epoch method row read against a 3-epoch fp16 upper bound and
# a 3-epoch-derived floor would be two variables, and the fp16 arm is exactly the row that says
# how much of any change is the DATA rather than the quantization (at 3 epochs it moved MMLU by
# -0.13 from the untrained 45.97, i.e. essentially nothing; at 6 it may not).
#
# Same law as part A: epochs 3 -> 6, every lr x sqrt(1941/3882) = 0.7071.
#
# QA-LoRA REUSES the 3-epoch run's frozen INT2 GPTQ base through a SYMLINK: scripts/train.py
# derives that path from output_dir and has no override flag, so the link is the only way to make
# the two cells share one set of codes (same trick as jobs/wiki2_ep1_all_arms.pbs). Rebuilding
# would produce the same codes from the same 128 C4 windows but would assert nothing.
#
# The three UNTRAINED anchors are epoch-independent and are not re-run.
# =============================================================================
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 HF_HUB_DISABLE_XET=1
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
mkdir -p logs/alpaca
echo "Start time: $(date)"

# --- QA-LoRA: link the 3-epoch GPTQ base in before training looks for it ----------------------
SRC_BASE=outputs/qalora_alpaca_int2_g32_ep3-2bit-qalora/qalora_intb_base
DST_DIR=outputs/qalora_alpaca_int2_g32_ep6-2bit-qalora
[ -d "$SRC_BASE" ] || { echo "ERROR: no 3-epoch QA-LoRA base at $SRC_BASE"; exit 1; }
mkdir -p "$DST_DIR"
[ -e "$DST_DIR/qalora_intb_base" ] || ln -s "$(cd "$SRC_BASE" && pwd)" "$DST_DIR/qalora_intb_base"
echo ">>> QA-LoRA base linked: $(readlink -f $DST_DIR/qalora_intb_base)"

echo -e "\n########## 1/3  QA-LoRA, 6 epochs ##########"
CFG_QA=configs/qalora_alpaca_int2_g32_ep6.yaml
OUT_QA=outputs/qalora_alpaca_int2_g32_ep6
bash runs/qalora/run_qalora_alpaca.sh \
    --config "$CFG_QA" --bits 2 --num_gpus 4 --output_dir "$OUT_QA" --skip_eval \
    > logs/alpaca/72_qalora_ep6_train.log 2>&1
echo "train rc=$?"
DEQ="${OUT_QA}-2bit-qalora-dequant-eval"
if [ -f "$DEQ/config.json" ]; then
    bash runs/eval_vllm.sh --model_path "$DEQ" --dataset alpaca --gpus 0,1,2,3 \
        --tag "$(basename $DEQ)" > logs/alpaca/73_qalora_ep6_mmlu.log 2>&1
    echo "mmlu rc=$?"
    python scripts/collect_saltq_results.py \
        --results_dir results/alpaca_mmlu --csv results_saltq.csv --config "$CFG_QA" \
        --filter "$(basename $DEQ)" \
        --note "T-Alpaca 6-epoch cell: QA-LoRA, same frozen codes as the 3-epoch run, lr x0.7071"
else
    echo "ERROR: no merged INT2 export at $DEQ"
fi

# --- QLoRA: the fp16 upper bound and the floor derived from it --------------------------------
echo -e "\n########## 2/3  QLoRA, 6 epochs -> merged fp16 UPPER + MMLU ##########"
CFG_QL=configs/qlora_none_alpaca_int2_g32_ep6.yaml
bash runs/qlora/run_qlora_alpaca.sh \
    --config "$CFG_QL" --bits 2 --num_gpus 4 \
    --output_dir outputs/qlora_none_alpaca_int2_g32_ep6 --skip_eval \
    > logs/alpaca/74_qlora_ep6_train.log 2>&1
echo "train rc=$?"
MERGED=outputs/qlora_none_alpaca_int2_g32_ep6-2bit-none-merged-eval
[ -f "$MERGED/config.json" ] || { echo "ERROR: no merged export at $MERGED"; exit 1; }
bash runs/eval_vllm.sh --model_path "$MERGED" --dataset alpaca --gpus 0,1,2,3 \
    --tag "$(basename $MERGED)" > logs/alpaca/75_qlora_ep6_upper_mmlu.log 2>&1
echo "upper rc=$?"

echo -e "\n########## 3/3  that checkpoint -> GPTQ INT2 g32 (FLOOR) + MMLU ##########"
FLOOR=outputs/qlora_none_alpaca_int2_g32_ep6-2bit-none-gptq-eval
if [ ! -f "$FLOOR/config.json" ]; then
    python scripts/export_gptq_dequant.py --model_path "$MERGED" --output_dir "$FLOOR" \
        --config "$CFG_QL" --bits 2 --group_size 32 --nsamples 128 --batch_size 2 \
        > logs/alpaca/76_floor_ep6_export.log 2>&1
    echo "export rc=$?"
fi
bash runs/eval_vllm.sh --model_path "$FLOOR" --dataset alpaca --gpus 0,1,2,3 \
    --tag "$(basename $FLOOR)" > logs/alpaca/76_floor_ep6_mmlu.log 2>&1
echo "floor rc=$?"

collect_one() {   # <model_dir substring> <config or ""> <note>
    python scripts/collect_saltq_results.py \
        --results_dir results/alpaca_mmlu --csv results_saltq.csv \
        --config "$2" --filter "$1" --note "$3"
}
collect_one "$(basename $MERGED)" "$CFG_QL" \
    "T-Alpaca 6-epoch cell UPPER: QLoRA adapter merged into fp16, never re-quantized"
collect_one "$(basename $FLOOR)" "$CFG_QL" \
    "T-Alpaca 6-epoch cell FLOOR: QLoRA merged fp16 -> GPTQ INT2 g32, C4 128x2048"

echo -e "\n>>> Alpaca INT2 g32, MMLU 5-shot, full epoch sweep"
python - <<'PY'
import glob, json, os
rows = []
for p in sorted(glob.glob("results/alpaca_mmlu/*.json")):
    r = json.load(open(p)).get("results", {})
    n = os.path.basename(p)[:-5]
    if "mmlu" in r and ("int2" in n or "2bit" in n or "fp16_anchor" in n):
        rows.append((n, 100*r["mmlu"]["acc,none"]))
for n, a in sorted(rows, key=lambda x: -x[1]):
    print(f"{n:<70} {a:6.2f}")
PY
echo "End time: $(date)"
