#!/bin/bash
#PBS -N cs_saltq_lr
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# SALT-Q Commonsense INT3 g64, 1 epoch, rates raised to the displacement targets + LN training.
# Anchored on autoseg + group_k=128, group_by_length off (the 79.04 configuration).
#
#                   measured p50   target      factor   INT3 rate
#   |dW_S| steps       0.273        ~0.5        1.83    3.46e-4 -> 6.34e-4
#   |ds_S| relative    1.59%        ~3%         1.88    1.73e-5 -> 3.26e-5
#   |dz_N| levels      0.015        0.1-0.3    10.0     1.73e-3 -> 1.73e-2
#
# z carries 98-99% of the weights and had moved almost nothing. o_proj stays at group_k=0 by
# necessity -- the quantizer groups along its input axis and a contiguous salient slice would
# break the group arithmetic -- so (s, z) is its ONLY adaptation, which is why zp_lr matters most
# there.
#
# Reuses the certified base (fingerprint-checked permutation + measured reconstruction error).
#
# AFTERWARDS, IN THIS ORDER:
#   1. scripts/measure_saltq_displacement.py. If |dz_N| overshoots past ~0.35 levels, halve zp_lr
#      and rerun rather than reading the score -- past ~0.5 the shift stops being an error
#      correction.
#   2. scripts/test_acc.py's dominant-output share. >=95% on any task means collapse, whatever
#      the mean says.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }
set -x
python scripts/test_saltq_base_provenance.py || exit 1
set +x
mkdir -p logs/commonsense_170k
bash runs/saltq/run_saltq_commonsense.sh \
    --config            configs/saltq_cs170k_int3_g64_ep1_lr.yaml \
    --bits              3 \
    --output_root       outputs/saltq_cs170k_int3_g64_ep1_lr \
    --train_layernorms  true \
    --permuted_base_dir outputs/saltq_cs170k_int3_g64_ep1/permuted_fp16_base \
    --saltq_base_dir    outputs/saltq_cs170k_int3_g64_ep1/saltq_base_3bit_g64 \
    --note              "1 epoch; rates x1.83/1.88/10 to displacement target; train_layernorms ON; autoseg k=128, gbl off" \
    > logs/commonsense_170k/saltq_cs170k_int3_g64_ep1_lr.log 2>&1
echo "rc=$?"; echo "End time: $(date)"
