#!/bin/bash
#PBS -N cs_saltq_int2_zonly
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# SALT-Q INT2 g32, 1 epoch, train_salient=FALSE. A DIAGNOSTIC, not a candidate.
#
# THE QUESTION. At INT2 every method sits on a loss plateau near 0.13, and what separates them is
# WHEN they leave it:
#
#   epoch        0.10    0.30    0.45    0.60    0.75    1.00     final   MEAN(7)
#   QA-LoRA     0.1315  0.1273  0.0836  0.0638  0.0578  0.0541    <-- escapes ~0.45   71.90
#   SALT-Q      0.1332  0.1298  0.1280  0.1231  0.0837  0.0680    <-- escapes ~0.75   65.77
#   SALT-Q x5zp 0.1332  0.1306  0.1385  0.1258     --      --     <-- later still
#   (INT3 has no plateau at all: QA-LoRA is at 0.0703 by epoch 0.10)
#
# SALT-Q loses ~0.3 of an epoch to the plateau and ends 6.13 points behind, and raising zp_lr made
# the escape LATER. So the earlier diagnosis was wrong: |dz| = 0.014 levels is a SYMPTOM of the
# plateau (grad_norm sits at 0.10-0.17, well under max_grad_norm 0.3, so nothing is being clipped
# and the gradient really is that small), not its cause.
#
# WHAT THIS RUN ISOLATES. The one structural thing SALT-Q has during the plateau that QA-LoRA does
# not is the salient QAT tier: 157.3M real weights trained THROUGH a 2-bit fakequant, i.e. through
# a straight-through estimator on a grid so coarse that |dW_S| = 0.041 steps never flips a code
# (0.5 would be needed). A biased STE gradient from a tier that cannot actually change its codes
# is a plausible thing to be holding the model on the plateau.
#
# train_salient=false removes exactly that tier and changes nothing else. It also makes SALT-Q
# structurally the full-rank version of QA-LoRA -- both then adapt only the zero-points.
#
# HOW TO READ IT, decided before the run:
#   escape near 0.45, like QA-LoRA  -> the salient tier is what delays the escape at INT2, and the
#                                      fix is in how the salient slice is trained, not in any lr
#   escape still near 0.75          -> the delay is in the frozen-code/(s,z) path itself and the
#                                      salient tier is exonerated; look at the base next
# The MEAN(7) is secondary here -- at INT3 z-only cost 0.95 points, so a lower score is expected
# and does not settle anything. READ THE ESCAPE EPOCH FROM THE LOSS CURVE.
#
# Reuses saltq_base_2bit_g32; train_salient does not change the base.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }

set -x
bash scripts/test_runs_wiring.sh || exit 1
set +x

mkdir -p logs/commonsense_170k
bash runs/saltq/run_saltq_commonsense.sh \
    --config            configs/saltq_cs170k_int2_g32_ep1_zonly.yaml \
    --bits              2 \
    --output_root       outputs/saltq_cs170k_int2_g32_ep1_zonly \
    --train_layernorms  false \
    --permuted_base_dir outputs/saltq_cs170k_int3_g64_ep1/permuted_fp16_base \
    --saltq_base_dir    outputs/saltq_cs170k_int2_g32_ep1/saltq_base_2bit_g32 \
    --note              'INT2 z-only: does removing the salient QAT tier move the plateau escape earlier than epoch 0.75' \
    > logs/commonsense_170k/saltq_cs170k_int2_g32_ep1_zonly.log 2>&1
echo "rc=$?"
echo "End time: $(date)"
