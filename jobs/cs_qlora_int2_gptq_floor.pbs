#!/bin/bash
#PBS -N cs_qlora_int2_floor
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=6:00:00
#PBS -j oe
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# QLoRA's REAL INT2 g32 deployment floor. NO TRAINING RUN IS NEEDED, and that is not a shortcut.
#
# src/model_loader.py:_get_bnb_config sends BOTH quant_bits=2 and quant_bits=3 down the same
# branch — bitsandbytes has no native 2-/3-bit, so the QLoRA base is loaded as 4-bit NF4 either
# way — and qat_mode=none puts no fakequant in the loop. quant_bits therefore only reaches the
# EXPORT quantizer. An INT2 QLoRA training run would be bit-for-bit identical to the INT3 one at
# the same seed: same base, same data, same 82.72 / 82.42 merged checkpoint. Re-running it would
# burn 12 GPU-hours to reproduce a number we have, and would add seed noise to the one row in the
# table that currently has none.
#
# So the fp16 upper bound carries over unchanged (MEAN(8) 82.72, MEAN(7) 82.42 +/- 0.33) and the
# only new thing at 2 bits is the export: GPTQ the SAME merged checkpoint at bits=2, g=32.
#
# Not the pipeline's own "dequant" arm: that is plain RTN (src/export.py's GPTQ state is
# sqat_permute-only), and RTN already destroyed the model at INT3 — "riiriirii..." to the token
# cap on all 22,419 prompts, 0.00 on all eight tasks. export_gptq_dequant.py runs the same
# error-compensated gptq_quantize_model_sequential (perm_group_k=0, perm_meta=None) that SALT-Q's
# frozen base and QA-LoRA's base are built with, so the floor and the methods are quantized alike.
#
# EXPECT THIS TO BE LOW. INT3 floor was 78.38 against an 82.42 ceiling; at 2 bits GPTQ on
# Llama-2-7b may land near majority-class. That is a legitimate result — it is exactly the room
# trainable (s,z) is supposed to occupy — but check beats_majority / dominant_output_share before
# reporting it as a score rather than a collapse.
set -e
mkdir -p logs/commonsense_170k
SRC=outputs/qlora_none_cs170k_int3_ep1-3bit-none-merged-eval
DST=outputs/qlora_none_cs170k_int2_ep1-2bit-none-gptq-eval

if [ ! -d "$DST" ]; then
  python scripts/export_gptq_dequant.py \
      --model_path "$SRC" --output_dir "$DST" \
      --config configs/qlora_none_cs170k_int2_g32_ep1.yaml \
      --bits 2 --group_size 32 \
      2>&1 | tee logs/commonsense_170k/qlora_gptq_int2_export.log
else
  echo "$DST already exists — skipping export"
fi

bash runs/eval_vllm.sh --model_path "$DST" --dataset commonsense --gpus 0,1,2,3 \
    --tag "$(basename $DST)" \
    > logs/commonsense_170k/qlora_gptq_int2_eval.log 2>&1
echo "rc=$?"; echo "End time: $(date)"
