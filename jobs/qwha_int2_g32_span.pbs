#!/bin/bash
#PBS -N qwha_int2_g32_span
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=24:00:00
#PBS -j oe

# QWHA baseline, INT2 g32, Commonsense-170k, 1 epoch, loss_span=instruction+response --
# the same cell as configs/qalora_cs170k_int2_g32_ep1_span.yaml and the SALT-Q span runs.
# Fine-tunes the AdaAlloc-initialized WHT adapter (lr from QWHA's own paper), exports the dense
# fp16 equivalent, and evaluates it through runs/eval_vllm.sh on the eight test sets.
# Depends on jobs/qwha_prep_int2_g32.pbs having produced the base + initialized adapter.
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
# Llama-2 and wikitext-2-raw-v1 are pre-fetched into HF_HOME on a login node; compute
# nodes have no route out.
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export HF_HUB_DISABLE_XET=1
nvidia-smi | head -12
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }
mkdir -p logs/qwha
bash baseline/QWHA/sqat/run_qwha_commonsense.sh \
    --config baseline/QWHA/sqat/configs/qwha_cs170k_int2_g32_ep1_span.yaml \
    --skip_quant --skip_init \
    > logs/qwha/qwha_int2_g32_span.log 2>&1
echo "rc=$?"; echo "End time: $(date)"
