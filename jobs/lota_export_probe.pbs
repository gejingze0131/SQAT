#!/bin/bash
#PBS -N lota_export_probe
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=1
#PBS -l walltime=03:00:00
#PBS -j oe

# The export-consistency check, at an omega low enough that markers actually fire.
#
# The smoke run passed bit-exactly at omega=48 while firing 0-35 markers, because ternary A/B
# at rank 64 give |AB| a std of ~5.3 and a five-step adapter never reaches 48. That verified
# the base and the offset factor and almost nothing about the INTEGER MERGE or the boundary
# masks -- which are exactly the parts that are easy to get wrong, and which bite hardest at
# 2 bits where the grid has four codes and q+marker must stay inside [0, maxq].
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
LOTA_ENV=/scratch/users/nus/jingzege/conda_envs/lota
LOG=logs/commonsense_170k/lota_export_probe.log
lota_py() {
    env -u PYTHONPATH -u PYTHONHOME \
        LD_LIBRARY_PATH="$LOTA_ENV/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        "$LOTA_ENV/bin/python" "$@"
}
nvidia-smi | head -12
mkdir -p logs/commonsense_170k
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1

set -x
# INT2 first: four codes, so the boundary masks are hit constantly.
lota_py baseline/LoTA-QAF/sqat/tests/test_export_consistency.py \
    --quantized_model_dir outputs/lota_bases/Llama-2-7B_int2_32_asym \
    --n_layers 8 --probe_omega 4 >> "$LOG" 2>&1 || exit 1
lota_py baseline/LoTA-QAF/sqat/tests/test_export_consistency.py \
    --quantized_model_dir outputs/lota_bases/Llama-2-7B_int3_64_asym \
    --n_layers 8 --probe_omega 4 >> "$LOG" 2>&1 || exit 1
set +x
echo "rc=$?"; echo "End time: $(date)"
