#!/bin/bash
#PBS -N csqa_int3
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=08:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# SALT-Q on CommonsenseQA, INT3 g64, autoseg fixed k=128, 3 epochs.
#
# Fast control for the commonsense-170k run, whose eval was measuring the wrong thing: that recipe
# trains on Alpaca-wrapped prompts targeting "the correct answer is X", while eval_benchmarks.py
# scores the stock lm-eval boolq/piqa/... tasks by likelihood ranking over bare continuations. The
# fine-tuning shifts the output distribution toward the instruction format, so the tuned model
# landed at or below base level (winogrande 58.0 vs ~69 base, arc_c 36.5 vs ~43, mmlu 36.1 vs ~46)
# despite training converging cleanly (loss 2.552 -> 0.418) and every mechanism checking out:
# boundary gathers registered (3 hooks), deploy equivalence exact (max|d| = 0).
#
# CommonsenseQA avoids the worst of that: `commonsense_qa` is itself an lm-eval task, so train and
# eval at least address the same dataset. --eval_tasks scores exactly that one task and skips the
# 8-task suite and MMLU, into results/commonsense_qa/.
#
# LEARNING RATES ARE RESCALED x4.25. CSQA is 9741 examples, so 3 epochs at effective batch 80 is
# only ~365 optimizer steps against the 6584 the INT3 rates were validated at. Under the measured
# law (|dparam| ~ lr * c, c ~ 0.47*sqrt(T)) the stock rates would realize 0.235x the intended
# movement, ~0.12 grid steps of |dW_S| against a 0.5 target — the same under-driving that cost
# run1 and run3. sqrt(6584/365) = 4.25, applied to all three rates. See the config header.
#
# AFTER THIS RUN: measure |dW_S| and |dz| BEFORE reading the score. Near 0.5 grid steps / 0.1-0.3
# levels means the rescale landed; anything much lower and the number is a floor, not the method.

set -x
python scripts/test_saltq.py           || exit 1
python scripts/test_gptq_nonsalient.py || exit 1
set +x

./run_saltq.sh \
    --config configs/saltq_csqa_int3_g64.yaml \
    --bits 3 \
    --dataset commonsense \
    --eval_tasks commonsense_qa \
    --output_root outputs/saltq_csqa_int3_g64 \
    --note "SALT-Q CommonsenseQA INT3 g64, autoseg fixed k=128, 3 epochs, lrs x4.25 for T=365" \
    > logs/commonsense_qa/saltq_csqa_int3_g64.log 2>&1

echo "End time: $(date)"
