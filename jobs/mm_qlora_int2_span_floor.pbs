#!/bin/bash
#PBS -N mm_qlora_int2_span_floor
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=6:00:00
#PBS -j oe
# FLOOR of the MetaMath INT2 g32 span bcal cell: GPTQ INT2 g32 re-export of the QLoRA merged fp16
# checkpoint (GSM8K 58.07), calibrated with the SAME balanced 1000-record MetaMath set the cell's
# SALT-Q / QA-LoRA bases use (nsamples == calibration_samples, the bcal rule). This is the
# "fine-tune in fp16, then PTQ" deployment bound that pairs with the fp16 upper 58.07 — the
# construction that gave the CS cell its floor (calib-D 66.22). The trained arms to place:
# SALT-Q 56.33 / QEFT 48.90 / QA-LoRA (15894078, running).
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh; conda activate saltq
nvidia-smi | head -12
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 HF_HUB_DISABLE_XET=1
mkdir -p logs/metamath
echo "Start time: $(date)"
SRC=outputs/qlora_none_mm_int2_ep1_span-2bit-none-merged-eval
DST=outputs/qlora_none_mm_int2_ep1_span-2bit-none-gptq-eval
python scripts/export_gptq_dequant.py --model_path "$SRC" --output_dir "$DST" \
    --config configs/qlora_none_mm_int2_g32_ep1_span.yaml --bits 2 --group_size 32 \
    --nsamples 1000 --calibration_samples 1000 --calibration_sampling balanced --batch_size 2 \
    2>&1 | tee logs/metamath/qlora_mm_span_gptq_int2_export.log
bash runs/eval_vllm.sh --model_path "$DST" --dataset math --gpus 0,1,2,3 \
    --tag "$(basename $DST)" > logs/metamath/qlora_mm_span_gptq_int2_eval.log 2>&1
echo "floor eval rc=$?"; echo "End time: $(date)"
