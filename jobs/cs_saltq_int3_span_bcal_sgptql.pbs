#!/bin/bash
#PBS -N cs_saltq_int3_span_bcal_sgptql
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe
# BALANCED-CALIBRATION ("bcal") cell: SALT-Q INT3 g64 k=128 sal5e5 span (old cell 77.76 on BoolQ-only bases)
# Training recipe byte-identical to the span-cell run it is derived from; the only change is the
# offline calibration set (task-balanced 3500 records, ~471k real tokens, into BOTH the saliency
# statistics and the GPTQ Hessians) — see the config header. The bases are built FRESH under the
# new output_dir (no --permuted_base_dir / --saltq_base_dir reuse: the old bases carry the
# BoolQ-only calibration this cell exists to replace). Extra cost vs the old cell: ~1 h of
# calibration (3500-sequence GPTQ took ~45 min in the floor diagnostic).
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }
set -x
bash scripts/test_runs_wiring.sh || exit 1
set +x
mkdir -p logs/commonsense_170k
echo "Start time: $(date)"
bash runs/saltq/run_saltq_commonsense.sh \
    --config            configs/saltq_cs170k_int3_g64_ep1_sal5e5_span_bcal_sgptql.yaml \
    --bits              3 \
    --output_root       outputs/saltq_cs170k_int3_g64_ep1_sal5e5_span_bcal_sgptql \
    --permuted_base_dir outputs/saltq_cs170k_int3_g64_ep1_sal5e5_span_bcal/permuted_fp16_base \
    --train_layernorms  false \
    --note              "bcal + salient_init=gptq_latent (INT3 replica of the INT2 best definition); single variable vs INT3 bcal 78.85" \
    > logs/commonsense_170k/saltq_cs170k_int3_g64_ep1_sal5e5_span_bcal_sgptql.log 2>&1
echo "rc=$?"
echo "End time: $(date)"
