#!/bin/bash
#PBS -N probe_refs
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=1
#PBS -l walltime=2:00:00
#PBS -j oe
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh; conda activate saltq
# Calibration points for the answer-token probe: a run that NEVER escaped the plateau (salient-
# LoRA alpha_S=16, generative MEAN(7) 40.93, 6/7 tasks at majority) and one that escaped late
# (1+3, escape 0.77, 61.00). Their ans_acc pins what "on the plateau" and "just escaped" read
# as on the probe's scale, so the loss_span run's step-500 value (0.490) can be placed.
mkdir -p logs/probe results/probe
python scripts/probe_answer_token.py \
    --config configs/saltq_cs170k_int2_g32_ep1_slora.yaml \
    --saltq_base_dir outputs/saltq_cs170k_int2_g32_ep1/saltq_base_2bit_g32 \
    --checkpoints outputs/saltq_cs170k_int2_g32_ep1_slora-2bit-saltq/final \
    --per_task 64 --batch 8 --out results/probe/saltq_cs170k_int2_g32_ep1_slora_final.json \
    > logs/probe/saltq_cs170k_int2_g32_ep1_slora_final.log 2>&1
echo "rc_slora=$?"
python scripts/probe_answer_token.py \
    --config configs/saltq_cs170k_int2_g32_ep1_zplora_recal.yaml \
    --saltq_base_dir outputs/saltq_cs170k_int2_g32_ep1/saltq_base_2bit_g32 \
    --checkpoints outputs/saltq_cs170k_int2_g32_ep1_zplora_recal-2bit-saltq/final \
    --per_task 64 --batch 8 --out results/probe/saltq_cs170k_int2_g32_ep1_zplora_recal_final.json \
    > logs/probe/saltq_cs170k_int2_g32_ep1_zplora_recal_final.log 2>&1
echo "rc_recal=$?"; echo "End time: $(date)"
