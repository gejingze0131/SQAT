#!/bin/bash
#PBS -N cs_qalora_int3_span_bcal
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe
# BALANCED-CALIBRATION ("bcal") cell: QA-LoRA INT3 g64 span (old cell 76.82 on a BoolQ-only GPTQ base)
# Training recipe byte-identical to the span-cell run it is derived from; the only change is the
# offline calibration set (task-balanced 3500 records, ~471k real tokens, into BOTH the saliency
# statistics and the GPTQ Hessians) — see the config header. The bases are built FRESH under the
# new output_dir (no --permuted_base_dir / --saltq_base_dir reuse: the old bases carry the
# BoolQ-only calibration this cell exists to replace). Extra cost vs the old cell: ~1 h of
# calibration (3500-sequence GPTQ took ~45 min in the floor diagnostic).
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }
set -x
bash scripts/test_runs_wiring.sh || exit 1
set +x
mkdir -p logs/commonsense_170k
echo "Start time: $(date)"
bash runs/qalora/run_qalora_commonsense.sh \
    --config     configs/qalora_cs170k_int3_g64_ep1_span_bcal.yaml \
    --bits       3 \
    --output_dir outputs/qalora_cs170k_int3_ep1_span_bcal \
    > logs/commonsense_170k/qalora_cs170k_int3_g64_ep1_span_bcal.log 2>&1
echo "rc=$?"
echo "End time: $(date)"
