#!/bin/bash
#PBS -N mixedprec_int2_g32_span
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh; conda activate saltq
nvidia-smi | head -12

# Mixed-precision salient ablation (fp16 salient slice + GPTQ non-salient, NO training) in the
# instruction+response cell at INT2 g32: the QLoRA merged checkpoint trained under
# data.loss_span=instruction+response (the cell's fp16 upper bound) is permuted with SALT-Q's
# saved segmentation, the top-k salient columns are kept in fp16 and the rest GPTQ'd, for
# group_k = 32 64 128 256 512 1024 2048. Same script and same code path as jobs/cs_mixedprec_int3_g64_sweep.pbs
# (the response-only INT3 sweep); only the checkpoint, bits/group_size and the k list differ.
# At g32 the smallest legal k is 32. The QLoRA span merged checkpoint is bit-identical between
# the INT2 and INT3 cells (NF4 training does not see quant_bits), so the two sweeps differ only
# in the deployment quantizer -- which is the point.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }
set -e
mkdir -p logs/commonsense_170k
python scripts/export_mixed_precision_sweep.py \
    --model_path    outputs/qlora_none_cs170k_int2_ep1_span-2bit-none-merged-eval \
    --perm_meta_dir outputs/saltq_cs170k_int3_g64_ep1/permuted_fp16_base \
    --config        configs/saltq_cs170k_int2_g32_ep1_span.yaml \
    --bits 2 --group_size 32 \
    --group_k 32 64 128 256 512 1024 2048 \
    --output_root   outputs/mixedprec_int2_g32_span \
    2>&1 | tee logs/commonsense_170k/mixedprec_int2_g32_span_export.log
for K in 32 64 128 256 512 1024 2048; do
    DIR=outputs/mixedprec_int2_g32_span/k${K}
    bash runs/eval_vllm.sh --model_path "$DIR" --dataset commonsense --gpus 0,1,2,3 \
        --tag "mixedprec_int2_g32_span_k${K}" \
        > logs/commonsense_170k/mixedprec_int2_g32_span_k${K}_eval.log 2>&1
    echo "k=$K eval rc=$?"
done
echo "End time: $(date)"
