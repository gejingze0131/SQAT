#!/bin/bash
#PBS -N cs_saltq_int2_span_lrup
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# SALT-Q INT2 g32, loss_span=instruction+response, LRS RAISED: zp_lr 1.73e-3 -> 5.0e-3 (math
# parity) and salient_lr 1.25e-4 -> 2.5e-4 (x2, half of math's x4). TWO VALUE EDITS vs the span
# run (67.29, probe ans_acc 0.684) -- see the yaml header for the displacement-based derivation
# and the pre-registered read order (displacement FIRST: salient p50 ~0.15-0.18 expected, >0.25
# = linearity failed, hold the score; then spikes -- none expected; then probe + MEAN(7) vs
# 67.29). Rationale in brief: both lrs were tuned where noise set the ceiling; dense supervision
# doubled the realised displacement at fixed lr with a still-improving tail, and the math cell
# runs 3-4x these lrs stably.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }

set -x
bash scripts/test_runs_wiring.sh || exit 1
set +x

mkdir -p logs/commonsense_170k
bash runs/saltq/run_saltq_commonsense.sh \
    --config            configs/saltq_cs170k_int2_g32_ep1_span_lrup.yaml \
    --bits              2 \
    --output_root       outputs/saltq_cs170k_int2_g32_ep1_span_lrup \
    --train_layernorms  false \
    --permuted_base_dir outputs/saltq_cs170k_int3_g64_ep1/permuted_fp16_base \
    --saltq_base_dir    outputs/saltq_cs170k_int2_g32_ep1/saltq_base_2bit_g32 \
    --note              "span cell, lrs raised: zp_lr 5e-3 (math parity) + salient_lr 2.5e-4 (x2); vs span 67.29" \
    > logs/commonsense_170k/saltq_cs170k_int2_g32_ep1_span_lrup.log 2>&1
echo "rc=$?"
echo "End time: $(date)"
