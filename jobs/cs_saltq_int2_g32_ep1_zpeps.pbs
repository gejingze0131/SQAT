#!/bin/bash
#PBS -N cs_saltq_int2_zpeps
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# SALT-Q INT2 g32, 1 epoch. ONE VARIABLE vs configs/saltq_cs170k_int2_g32_ep1.yaml (65.77):
# Adam's eps for the ZERO-POINT param group, 1.0e-8 -> 1.0e-10.
#
# This run is simultaneously the fix and its own diagnostic — see MEASURE THE PLATEAU below.
#
# =============================================================================================
# RESULT: FAILED. Never escaped. Final loss 0.1286, MEAN(7) 38.57, 7 of 7 tasks below their
# majority class. That is the SAME failure as zp_lr x5 (0.1287, 38.28, the same 7/7), and the
# match is the finding: the two knobs do the same thing. The read rule below fired its LAST
# branch ("escape LATER / diverges -> the answer is averaging or low rank, not the floor").
#
# The measurement in this header is real; the DIRECTION taken from it was wrong. eps sitting at
# 26% of the denominator was not merely damping the tier, it was partially DE-NORMALISING it,
# and lowering it made Adam normalise HARDER. The defect is that per-coordinate normalisation
# destroys the gradient's concentration -- measured afterwards on the z-only optimizer state:
# gradient stable rank 1.83 (top-1 54.9%) but the APPLIED update 6.87 (top-1 15.5%). Follow-up
# is jobs/cs_saltq_int2_g32_ep1_zonly_ptv.pbs, which changes the denominator's SHAPE, not its
# size. This file is kept as the record of a clean negative.
# =============================================================================================
#
# ---------------------------------------------------------------------------------------------
# WHERE THE PLATEAU STANDS. At INT2 g32 every method parks near loss 0.13 and only the exit
# epoch differs (loss < 0.110, sustained):
#
#   QA-LoRA INT2          escapes 0.347   final 0.0541   MEAN(7) 71.90
#   SALT-Q  INT2 anchor   escapes 0.672   final 0.0680   MEAN(7) 65.77
#   SALT-Q  zp_lr x5      NEVER           final 0.1287   MEAN(7) 38.28  (7/7 degenerate)
#   SALT-Q  z-only        escapes 0.938   final 0.1151   MEAN(7) 48.54  (train_salient=false)
#
# THE z-ONLY RUN CAME BACK AND IT ANSWERS NEITHER BRANCH OF ITS OWN READ RULE. It does not
# escape at 0.45 and it does not escape at 0.75 — it escapes at 0.938, i.e. essentially not
# within the epoch at all, and scores 48.54. Its frozen-code
# base is just as good as the anchor's (reconstruction error 53.3% vs 54.1%), so the ablation is
# clean, and the conclusion is stronger than either registered option: the salient QAT tier is
# not a brake on the escape, it is the ONLY ENGINE OF IT. The (s,z) path cannot leave the plateau
# in one epoch by itself. SALT-Q therefore does all of its INT2 repair with 157.3M trainable
# weights = 2.3% of the model, while QA-LoRA's adapter covers every input column of all 224
# projections. That is why 0.672 vs 0.347.
#
# ---------------------------------------------------------------------------------------------
# WHAT THIS RUN CHANGES, AND WHY IT IS NOT ANOTHER zp_lr EXPERIMENT.
#
# The lr derivation in the config opens with "under Adam the update is lr * m/(sqrt(v)+eps), so a
# constant factor on the gradient CANCELS — only lr matters". True when eps << sqrt(v). But eps is
# an ABSOLUTE floor while each tier's gradient magnitude is set by the unit it lives in, and
# dL/dz = -s * sum_g(dL/dW) lands at ~1e-8 at INT2 g32 precisely BECAUSE z is measured in LEVELS.
# So the premise fails for the one tier that same block calls "the entire freedom of the
# non-salient 98%". Measured with scripts/measure_adam_conditioning.py (new) on the anchor's own
# outputs/saltq_cs170k_int2_g32_ep1-2bit-saltq/checkpoint-1845/optimizer.pt:
#
#   tier              sqrt(v) p50   % below eps=1e-8   sqrt(v)/(sqrt(v)+eps) at p50 / p10
#   salient weights     6.945e-7           7.7%                0.986 / 0.741
#   LSQ scales          2.880e-7           2.8%                0.966 / 0.808
#   ZERO-POINTS         2.784e-8          31.5%                0.736 / 0.150
#   (QA-LoRA adapter    8.233e-7           0.8%                0.988 / 0.915)
#
# A third of all zero-points sit UNDER the floor. The median loses 26% of its Adam step, the
# bottom decile 85%, and no other tier in either method is within an order of magnitude of that.
# zp_lr x5 is already dead as a direction — it moved |dz| by 4.8x exactly as predicted and cost
# 27.5 points, because an lr multiplies signal and noise alike. eps damping is the opposite kind
# of defect: it is SELECTIVE against small-gradient coordinates, so lifting it changes the SHAPE
# of the update, not its scale. That knob has never been moved on this dataset.
#
# 1.0e-10 is not tuned. It is the value that gives this tier the same ~0.4% eps/sqrt(v) ratio the
# salient tier already has — the floor put back below the signal. salient_lr and scales_lr keep
# 1e-8 on purpose (1.4% / 3.4% median damping is not worth a variable, and moving them would
# break the comparison against the validated INT3 anchor at 81.48).
#
# ---------------------------------------------------------------------------------------------
# MEASURE THE PLATEAU — the reason save_steps went 500 -> 200 and save_total_limit 1 -> 12.
#
# The table above is an END-OF-TRAINING read: v is an EMA with beta2=0.999, so at step 1845 it
# describes roughly the second half of the run. Gradients on the plateau are ~10x SMALLER than
# after the escape (logged grad_norm p50 0.144 on the plateau vs 1.557 late), so 31.5% / 0.736 is
# a LOWER BOUND on the damping during the plateau, which is when it matters. save_total_limit 1
# is why that could not be checked before: every plateau checkpoint the anchor wrote was deleted.
#
# The plateau is steps ~185-645 of 1845, so checkpoints at 200/400/600 land inside it. Neither
# save key touches the trajectory (saving is read-only w.r.t. params, RNG and the dataloader), so
# this is still a ONE-variable run. AS SOON AS checkpoint-200 EXISTS, without waiting for the run:
#
#   python scripts/measure_adam_conditioning.py \
#       outputs/saltq_cs170k_int2_g32_ep1_zpeps-2bit-saltq/checkpoint-200/optimizer.pt \
#       --label "plateau, step 200, zp_eps=1e-10" --eps 1e-8
#
# --eps 1e-8 is the point: sqrt(v) is what is measured, so passing the OLD eps prints the damping
# the ANCHOR was suffering at that step. (sqrt(v) transfers between the two runs only while the
# trajectories still agree — check that by comparing loss at step 200 against the anchor's log.)
#
# ---------------------------------------------------------------------------------------------
# HOW TO READ IT. Decided before the run. The escape epoch comes from the LOSS CURVE, not MEAN(7).
#
#   escape moves earlier than 0.672            -> eps damping was a real brake on z. Size of the
#                                                 move says how much of the 0.347-vs-0.672 gap it
#                                                 owns; the rest is the 2.3% engine (group_k, or
#                                                 train_scale, or a low-rank z).
#   escape unchanged near 0.672, AND the step-
#     200 damping came out mild (>0.8)         -> the end-of-training number did not transfer;
#                                                 eps was never the brake. Drop it as a cause,
#                                                 keep the fix (it is still the wrong unit).
#   escape unchanged near 0.672, AND the step-
#     200 damping came out severe (<0.5)       -> eps WAS crushing a third of z's coordinates and
#                                                 undamping them still changes nothing. That kills
#                                                 the whole "z is the problem" family and says the
#                                                 escape is the salient tier's alone -> group_k
#                                                 and train_scale are next, not z.
#   escape LATER / diverges                    -> z's gradient really is noise (measured r=0.199
#                                                 vs a 0.229 pure-noise floor) and undamping it
#                                                 just injects more of it. Then the answer is
#                                                 averaging (beta1) or low rank, not the floor.
#
# MEAN(7) is secondary. Also check dominant_output_share / beats_majority before believing any
# INT2 score — the anchor already has boolq collapsed below majority.
#
# ---------------------------------------------------------------------------------------------
# BASE REUSE. train_salient, bits, group_size, group_k and the permutation are all unchanged from
# the anchor, so BOTH bases are reused and the frozen codes are bit-identical to the run this is
# compared against. That matters: it removes GPTQ from the list of things that could differ.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }

set -x
bash scripts/test_runs_wiring.sh || exit 1
set +x

mkdir -p logs/commonsense_170k
bash runs/saltq/run_saltq_commonsense.sh \
    --config            configs/saltq_cs170k_int2_g32_ep1_zpeps.yaml \
    --bits              2 \
    --output_root       outputs/saltq_cs170k_int2_g32_ep1_zpeps \
    --train_layernorms  false \
    --permuted_base_dir outputs/saltq_cs170k_int3_g64_ep1/permuted_fp16_base \
    --saltq_base_dir    outputs/saltq_cs170k_int2_g32_ep1/saltq_base_2bit_g32 \
    --note              'INT2 zp_eps 1e-8 -> 1e-10: does undamping the zero-point tier move the plateau escape earlier than epoch 0.672' \
    > logs/commonsense_170k/saltq_cs170k_int2_g32_ep1_zpeps.log 2>&1
echo "rc=$?"
echo "End time: $(date)"
