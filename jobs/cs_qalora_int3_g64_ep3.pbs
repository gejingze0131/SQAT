#!/bin/bash
#PBS -N cs_qalora_ep3
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=24:00:00
#PBS -j oe
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh; conda activate saltq; nvidia-smi | head -12

# QA-LoRA baseline, Commonsense INT3 g64, THREE EPOCHS. lr stays at its own 5e-3.
# Genuinely quantized end to end (real GPTQ INT-b base, no NF4), so the score is already a
# deployment number. At 1 epoch: MEAN(7) 80.92 +- 0.34 against SALT-Q's 81.48 +- 0.34 -- level.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine"; exit 1; }
mkdir -p logs/commonsense_170k
bash runs/qalora/run_qalora_commonsense.sh \
    --config     configs/qalora_cs170k_int3_g64_ep3.yaml \
    --bits       3 \
    --output_dir outputs/qalora_cs170k_int3_ep3 \
    > logs/commonsense_170k/qalora_cs170k_int3_g64_ep3.log 2>&1
echo "rc=$?"; echo "End time: $(date)"
