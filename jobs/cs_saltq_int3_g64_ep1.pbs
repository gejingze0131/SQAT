#!/bin/bash
#PBS -N cs_saltq_int3_g64_ep1
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=24:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# SALT-Q on Commonsense-170k, INT3 g64, ONE epoch.
#
# The first run of the repo on the new footing: PiSSA-style data (datasets/commonsense, prompt
# masked, response-only loss, explicit EOS) and generative evaluation through vLLM instead of
# lm-eval. So it is NOT comparable to the earlier lm-eval numbers in results_saltq.csv — those
# rank answer options under teacher forcing, this scores the model's own generations. The CSV
# keeps them apart with source=lm-eval vs source=vllm-generative; do not average across that
# column.
#
# LEARNING RATES ARE x sqrt(3). One epoch is T = 147580 / 80 = 1845 optimizer steps against the
# 5534 of the 3-epoch cell, and SALT-Q's rates are set against a target DISPLACEMENT under
# |dparam| ~ lr * 0.47 * sqrt(T). Unscaled they would realize 0.34 grid steps of |dW_S| against
# a 0.5 target. See the config header for the full derivation.
#
# THE OFFLINE BASES ARE REUSED from the 3-epoch run. Neither the permutation (13 GB) nor the
# frozen GPTQ codes (7.3 GB) depends on the number of epochs -- only on the saliency /
# segmentation config and on (bits, group_size), all identical here. That skips ~2 GPU-hours of
# calibration plus a 20 GB rewrite. The one caveat worth recording: those bases were calibrated
# under the OLD prompt formatting, which for this dataset differs from the new one by the
# template tail alone, so the second-moment statistics that chose the salient channels are
# unchanged for practical purposes. If a strictly single-provenance base is ever wanted, drop
# the two --*_base_dir flags and it rebuilds.
#
# Results are recorded automatically by stage 3: generations to
# results/commonsense_vllm/<tag>.jsonl, per-task accuracy to <tag>.json, and one row per task
# folded into results_saltq.csv by scripts/collect_saltq_results.py.
#
# AFTER THIS RUN: measure |dW_S| and |dz| with scripts/measure_saltq_displacement.py BEFORE
# trusting the score. Near 0.5 grid steps / 0.1-0.3 levels means the sqrt(3) rescale landed;
# much lower and the number is a floor on the method, not a measurement of it.

# Stage 3 runs in a DIFFERENT conda env. Check it is importable now rather than discovering it
# is missing after several hours of training.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node; see runs/eval_vllm.sh stage 2"; exit 1; }

set -x
python scripts/test_saltq.py           || exit 1
python scripts/test_unpermute_fold.py  || exit 1
set +x

mkdir -p logs/commonsense_170k

bash runs/saltq/run_saltq_commonsense.sh \
    --config configs/saltq_cs170k_int3_g64_ep1.yaml \
    --bits 3 \
    --output_root outputs/saltq_cs170k_int3_g64_ep1 \
    --permuted_base_dir outputs/saltq_cs170k_int3_g64/permuted_fp16_base \
    --saltq_base_dir    outputs/saltq_cs170k_int3_g64/saltq_base_3bit_g64 \
    --note "1 epoch (T=1845), lrs x sqrt(3); first run on the PiSSA data pipeline + vLLM generative eval" \
    > logs/commonsense_170k/saltq_cs170k_int3_g64_ep1.log 2>&1

echo "End time: $(date)"
