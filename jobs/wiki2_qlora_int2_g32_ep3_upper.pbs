#!/bin/bash
#PBS -N wiki2_qlora_upper
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe
# =============================================================================
# T2 Wiki2 column, arm QLoRA fp16 UPPER BOUND. NF4 QLoRA r=64 a=16 at lr 3.74e-4 =
# 2.0e-4 x sqrt(1845/528), then exported as
#   outputs/qlora_none_wiki2_int2_g32_ep3-2bit-none-merged-eval
# = NF4 base dequantized + adapter merged, dense fp16. That is the ADAPTER-MOUNTED deployed
# state; nothing has been re-quantized, so the row is fp16, not INT2.
#
# The FLOOR (this same checkpoint -> GPTQ INT2 g32) is jobs/wiki2_qlora_int2_floor.pbs, chained
# after this one: it is a different artifact and gets its own row.
#
# The pipeline also exports and scores <output_dir>-2bit-none-dequant-eval (the NF4 round-trip);
# that is not a row of this column, it comes along because Stage 3 evaluates both exports.
# =============================================================================
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 HF_HUB_DISABLE_XET=1
mkdir -p logs/wikitext2
echo "Start time: $(date)"
bash runs/qlora/run_qlora_wikitext2.sh \
    --bits       2 \
    --num_gpus   4 \
    --output_dir outputs/qlora_none_wiki2_int2_g32_ep3 \
    > logs/wikitext2/qlora_none_wiki2_int2_g32_ep3.log 2>&1
echo "rc=$?"
echo "End time: $(date)"
