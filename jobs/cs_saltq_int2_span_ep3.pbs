#!/bin/bash
#PBS -N cs_saltq_int2_span_ep3
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=4
#PBS -l walltime=16:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12

# SALT-Q INT2 g32, span cell, 3 EPOCHS. ONE KEY vs the 1-epoch span run (67.16 MEAN(8) / 67.29
# MEAN(7)): num_epochs 1 -> 3, lrs at their bracketed peak. Same base, same segmentation. The
# response-only cell made the same move (65.77 -> 72.24). Every span-cell run is still
# descending at the end of epoch 1; this measures how much of that is budget. Read against the
# 1-epoch span point and, once run, a same-span 3-epoch QA-LoRA -- not against 1-epoch QA-LoRA.
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }

set -x
bash scripts/test_runs_wiring.sh || exit 1
set +x

mkdir -p logs/commonsense_170k
bash runs/saltq/run_saltq_commonsense.sh \
    --config            configs/saltq_cs170k_int2_g32_ep3_span.yaml \
    --bits              2 \
    --output_root       outputs/saltq_cs170k_int2_g32_ep3_span \
    --train_layernorms  false \
    --permuted_base_dir outputs/saltq_cs170k_int3_g64_ep1/permuted_fp16_base \
    --saltq_base_dir    outputs/saltq_cs170k_int2_g32_ep1/saltq_base_2bit_g32 \
    --note              "span cell, 3 epochs, lrs unchanged (vs 1-epoch span 67.16); loss still descending at 1 epoch" \
    > logs/commonsense_170k/saltq_cs170k_int2_g32_ep3_span.log 2>&1
echo "rc=$?"
echo "End time: $(date)"
