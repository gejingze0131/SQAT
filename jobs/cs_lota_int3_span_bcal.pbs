#!/bin/bash
#PBS -N cs_lota_int3_bcal
#PBS -q normal
#PBS -P personal-jingzege
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe

# LoTA-QAF INT3 g64 on the bcal base, the paper's main-table sigma_t (5%).
#
# HOW TO READ IT. Only against bcal rows — fp16 77.75, GPTQ floor 76.05, QA-LoRA 77.71,
# SALT-Q 78.85 — and against its OWN --with_base floor for gap recovered, because LoTA-QAF
# trains on a base this repo built but never fine-tuned, while the 76.05 floor row is a QLoRA
# checkpoint merged and then quantized and therefore already knows the answer format.
#
# The base is shared with the other arm and must already exist (jobs/lota_bcal_base_int3.pbs);
# --base_dir implies --skip_quant, so nothing here can rebuild it under a trained adapter.
cd "$PBS_O_WORKDIR" || exit 1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate saltq
nvidia-smi | head -12
conda run -n vllm-eval python -c "import sqlite3, vllm; from vllm.v1.engine.core_client import EngineCoreClient" \
  || { echo "vllm env cannot import the engine on this node"; exit 1; }
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
mkdir -p logs/commonsense_170k
bash runs/lota/run_lota_commonsense.sh \
    --config     baseline/LoTA-QAF/sqat/configs/lota_cs170k_int3_g64_ep1_span_bcal.yaml \
    --bits       3 \
    --group_size 64 \
    --base_dir   outputs/lota_bases/Llama-2-7B_bcal_int3_64_asym_sqatcal \
    --with_base \
    --note       "bcal matched base (balanced 3500, this repo's GPTQ grid); the paper's main-table sigma_t (5%)" \
    > logs/commonsense_170k/lota_cs170k_int3_g64_ep1_span_bcal.log 2>&1
echo "rc=$?"; echo "End time: $(date)"
